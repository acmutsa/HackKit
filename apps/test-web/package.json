{
  "name": "test-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "plugin:sync": "hackkit plugin sync",
    "db:reset": "bash scripts/db-reset.sh",
    "db:sync": "hackkit db sync",
    "test:db-bootstrap": "bash scripts/test-local-db-bootstrap.sh",
    "sync": "pnpm plugin:sync && pnpm db:sync",
    "predev": "bash scripts/bootstrap-local-db.sh && turbo run build --filter=test-web^...",
    "dev": "next dev -p 3000",
    "build": "next build",
    "verify": "pnpm sync && pnpm typecheck && pnpm build",
    "start": "next start",
    "studio": "drizzle-kit studio",
    "typecheck": "turbo run build --filter=@hackkit/cli && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hackkit/auth-better-auth": "workspace:*",
    "@hackkit/blob-local": "workspace:*",
    "@hackkit/blob-s3": "workspace:*",
    "@hackkit/cli": "workspace:*",
    "@hackkit/config": "workspace:*",
    "@hackkit/core": "workspace:*",
    "@hackkit/next": "workspace:*",
    "@hackkit/plugin-discord": "workspace:*",
    "@hackkit/plugin-notifications-email": "workspace:*",
    "@hackkit/plugin-teams": "workspace:*",
    "@hackkit/ui": "workspace:*",
    "@libsql/client": "^0.14.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.39.3",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^1.5.0",
    "typescript": "5.5.3"
  },
  "devDependencies": {
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "drizzle-kit": "0.30.4",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "1.0.7"
  }
}
