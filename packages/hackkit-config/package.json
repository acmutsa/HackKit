{
  "name": "@hackkit/config",
  "version": "0.0.0",
  "description": "Shared HackKit app configuration types and loader",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hackkit/core": "workspace:*",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "20.14.11",
    "typescript": "5.5.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
