{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
    "globalEnv": [
        "AWS_ACCESS_KEY_ID",
        "AWS_REGION",
        "AWS_S3_BUCKET",
        "AWS_S3_ENDPOINT",
        "AWS_S3_REGION",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SES_ACCESS_KEY",
        "AWS_SES_EMAIL_FROM",
        "AWS_SES_SECRET_ACCESS_KEY",
        "BACKUP_CRON_SCHEDULE",
        "BACKUP_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "BETTER_AUTH_URL",
        "BOT_API_URL",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "DISCORD_CLIENT_ID",
        "DISCORD_DEV_SERVER_ID",
        "DISCORD_DEV_VERIFY_CHANNEL_ID",
        "DISCORD_PROD_SERVER_ID",
        "DISCORD_PROD_VERIFY_CHANNEL_ID",
        "DISCORD_SECRET_TOKEN",
        "NODE_ENV",
        "INTERNAL_AUTH_KEY",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
        "NEXT_PUBLIC_APP_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "HACKKIT_BLOB_ADAPTER",
        "HACKKIT_LOCAL_BLOB_BASE_DIR",
        "HACKKIT_OWNER_AUTH_ID_ALLOWLIST",
        "HACKKIT_OWNER_EMAIL_ALLOWLIST",
        "HACKKIT_S3_ACCESS_KEY_ID",
        "HACKKIT_S3_BUCKET",
        "HACKKIT_S3_ENDPOINT",
        "HACKKIT_S3_REGION",
        "HACKKIT_S3_SECRET_ACCESS_KEY",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "TURSO_AUTH_TOKEN",
        "TURSO_DATABASE_URL"
      ],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
